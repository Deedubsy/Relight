+.build-select {font-size:var(--ui-heading);width:100%;text-align:left;}
+.build-select[aria-pressed=true] {border:2px solid var(--ui-accent);}
+.build-price {color:var(--ui-secondary);font-size:var(--ui-small);}
+.build-stock {margin-top:8px;color:var(--ui-accent);}
+.build-reason {font-size:var(--ui-small);}
+#build-body-Shortcuts label,#build-body-Shortcuts select {display:block;width:100%;margin:8px 0;}
+#build-body-Shortcuts button {margin:4px;}
+.quickbar {flex-basis:100%;width:100%;display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:4px;}
+.quickbar-slot {position:relative;min-width:0;min-height:76px;padding:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.2;}
+.quickbar-slot kbd {align-self:flex-start;font-size:var(--ui-small);}
+.quickbar-name {font-size:var(--ui-small);white-space:nowrap;}
+.quickbar-count {font-size:var(--ui-small);color:var(--ui-secondary);margin-top:4px;}
+.quickbar-slot[aria-pressed=true] {border:2px solid var(--ui-accent);background:var(--ui-raised);}
+.quickbar-slot[aria-pressed=true] .quickbar-name::before {content:'• ';color:var(--ui-accent);}
+.placement-toolbar {flex-basis:100%;display:flex;align-items:center;justify-content:center;gap:8px;font-size:var(--ui-small);}
+.placement-toolbar button {padding:4px 8px;}
+.ui-navigation:has(.quickbar) {width:min(1120px,calc(100vw - 24px));gap:6px;padding:8px;}
+.ui-navigation:has(.quickbar) .ui-brand {display:none;}
+.ui-navigation:has(.quickbar) > button {padding:4px 8px;}
+.hud-prompt.placement-prompt {bottom:auto;transform:none;max-width:320px;width:max-content;}
+@media(max-width:1000px){.quickbar-count {font-size:var(--ui-small);} .quickbar-name {font-size:var(--ui-small);} .ui-navigation:has(.quickbar) {justify-content:center;}}
+
+.quickbar-more > summary {cursor:pointer;padding:6px 12px;border:1px solid var(--ui-border);border-radius:6px;list-style:none;background:var(--ui-surface);}
+.quickbar-more[open] > summary {border:2px solid var(--ui-accent);}
+.quickbar-more-actions {position:absolute;right:8px;bottom:calc(100% + 8px);display:grid;gap:8px;padding:12px;min-width:200px;background:var(--ui-bg);border:1px solid var(--ui-border);border-radius:6px;}
