/*
 * HUD — C-07. Regions and states only; every colour and size is a token from Styles/tokens.uss.
 *
 * Two rules this sheet exists to keep:
 *   - the HUD is NOT a panel. It carries no "panel" class, so UiShell.Rebuild() never hides it and it stays
 *     readable behind every drawer (UI_AND_ONBOARDING.md §4.1).
 *   - nothing in C# writes a style. Every state below is a class HudController adds or removes.
 *
 * Layer order (§4.1) is DOM order, because USS has no z-index: world, hud, drawer, inventory, tooltip, modal,
 * alert. The tokens --ui-hud … carry the numbers for anyone who needs to reason about the order; the HUD itself
 * is simply the first child of the shell document.
 */

#hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    color: var(--ui-text);
}

/* ---- shared ---------------------------------------------------------------------------------------------- */

.hud-block {
    position: absolute;
    background-color: var(--ui-surface);
    border-left-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-top-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    padding-left: var(--ui-space-3);
    padding-right: var(--ui-space-3);
    padding-top: var(--ui-space-2);
    padding-bottom: var(--ui-space-2);
}

.hud-line {
    font-size: var(--ui-font-size-body);
    color: var(--ui-text);
    white-space: nowrap;
}

.hud-sub {
    font-size: var(--ui-font-size-small);
    color: var(--ui-secondary);
    white-space: nowrap;
}

.hud-meter {
    height: 6px;
    margin-top: var(--ui-space-1);
    margin-bottom: var(--ui-space-1);
}

.hud-meter .unity-progress-bar__background {
    background-color: var(--ui-bg);
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    min-height: 6px;
}

.hud-meter .unity-progress-bar__progress {
    background-color: var(--ui-working);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    min-height: 6px;
}

.hud-meter .unity-progress-bar__title-container {
    display: none;
}

.is-hidden {
    display: none;
}

.is-danger {
    color: var(--ui-danger);
}

.is-accent {
    color: var(--ui-accent);
}

/* ---- top-centre status strip: content width, never full width (§4.1) ------------------------------------- */

#status-strip {
    /* U-5: content-width, centred — no left/right insets, so the strip never spans the window. */
    top: var(--ui-top-inset);
    align-self: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-top: var(--ui-space-2);
}

#status-content {
    flex-direction: row;
    align-items: center;
    background-color: var(--ui-surface);
    border-left-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-top-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    padding-left: var(--ui-space-3);
    padding-right: var(--ui-space-3);
    padding-top: var(--ui-space-1);
    padding-bottom: var(--ui-space-1);
}

/*
 * W-B R1. Three contained blocks of equal height. Each block owns its own horizontal space and CLIPS, so a long
 * power or core string can no longer push its neighbour sideways or spill the meter out of the strip (the owner's
 * screenshot). The 680px cap keeps the centred strip clear of the threat block in the top-right corner at 1280.
 */
#status-content {
    max-width: 680px;
    align-items: stretch;
}

.strip-block {
    flex-direction: column;
    justify-content: center;
    flex-shrink: 1;
    overflow: hidden;
    padding-left: var(--ui-space-3);
    padding-right: var(--ui-space-3);
}

.strip-value {
    font-size: var(--ui-font-size-body);
    color: var(--ui-text);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.strip-rule {
    width: 1px;
    flex-shrink: 0;
    background-color: var(--ui-border);
    opacity: 0.45;
    margin-top: var(--ui-space-1);
    margin-bottom: var(--ui-space-1);
}

#clock-block {
    flex-shrink: 0;
}

#core-block {
    /* Fixed, so the meter under the label has a stable width instead of inheriting a text-sized parent.
       240 fits "Home core · 300/300 HP" plus the block padding; 210 showed "Home core · 300/300…" (coordinator). */
    width: 240px;
    flex-shrink: 0;
}

#core-meter {
    width: 100%;
    margin-bottom: 0;
}

/* ---- upper right: the threat line ------------------------------------------------------------------------- */

#threat {
    top: var(--ui-space-4);
    right: var(--ui-space-4);
    flex-direction: row;
    align-items: center;
}

#threat-pip {
    width: 10px;
    height: 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: var(--ui-danger);
    margin-right: var(--ui-space-2);
    opacity: 0.25;
}

#threat-pip.pip-on {
    opacity: 1;
}

/* Reduced motion (§11): the pip never blinks, it simply stands lit. HudController stops toggling the class and
   this rule makes the resting state the lit one, so no information is lost. */
.motion-reduce #threat-pip {
    opacity: 1;
}

/* ---- alerts: one urgent strip, then at most three keyed rows (§8) ----------------------------------------- */

#alerts {
    top: 96px;
    right: var(--ui-space-4);
    width: 340px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: flex-end;
}

.alert-strip {
    font-size: var(--ui-font-size-body);
    color: var(--ui-bg);
    background-color: var(--ui-danger);
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    padding-left: var(--ui-space-3);
    padding-right: var(--ui-space-3);
    padding-top: var(--ui-space-1);
    padding-bottom: var(--ui-space-1);
    margin-bottom: var(--ui-space-1);
    white-space: normal;
    max-width: 100%;
}

.notice-row {
    font-size: var(--ui-font-size-small);
    color: var(--ui-text);
    background-color: var(--ui-raised);
    border-left-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-top-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    padding-left: var(--ui-space-2);
    padding-right: var(--ui-space-2);
    padding-top: var(--ui-space-1);
    padding-bottom: var(--ui-space-1);
    margin-bottom: var(--ui-space-1);
    white-space: normal;
    /* align-items: flex-end shrinks a row to its text; without this cap a long director notice ran off the left
       edge of the window instead of wrapping (integrated run, 2026-09-14). */
    max-width: 100%;
}

.notice-warning {
    color: var(--ui-accent);
}

/* REL-86 (UI-02a): the live notices the three rows above leave out are counted here ("+2 more"), so a fourth alert
   is never lost without a trace. Plain text under the rows, not a fourth row: it is a count, not a notice. */
.notice-more {
    font-size: var(--ui-font-size-small);
    color: var(--ui-secondary);
    -unity-text-align: middle-right;
    padding-right: var(--ui-space-2);
    margin-bottom: var(--ui-space-1);
}

.notice-danger {
    color: var(--ui-danger);
}

/* ---- machine problems ------------------------------------------------------------------------------------- */

#problems {
    bottom: 160px;
    right: var(--ui-space-4);
    width: 340px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: flex-end;
}

.problem-row {
    font-size: var(--ui-font-size-small);
    color: var(--ui-secondary);
    white-space: normal;
    -unity-text-align: middle-right;
}

/* ---- bottom left: engineer, weapon, carry ---------------------------------------------------------------- */

#engineer-block {
    left: var(--ui-space-4);
    bottom: var(--ui-space-4);
    width: 300px;
}

/* ---- mining feedback, just above the engineer block ------------------------------------------------------- */

#mining {
    left: var(--ui-space-4);
    bottom: 176px;
    width: 300px;
}

#mining-title {
    font-size: var(--ui-font-size-body);
    color: var(--ui-accent);
}

/* ---- the hand-craft lock prompt, centred low -------------------------------------------------------------- */

#hand-lock {
    left: 0;
    right: 0;
    /* W-B R1: above the placement toolbar (bottom 72) and the action bar (bottom 16), which are both centred. */
    bottom: 220px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

#hand-lock-text {
    font-size: var(--ui-font-size-body);
    color: var(--ui-bg);
    background-color: var(--ui-accent);
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    padding-left: var(--ui-space-3);
    padding-right: var(--ui-space-3);
    padding-top: var(--ui-space-1);
    padding-bottom: var(--ui-space-1);
}

/* ---- placement toolbar (W-B R3): centred low, above the action bar -------------------------------------- */

#placement-toolbar {
    left: 0;
    right: 0;
    /* Above the opening-hint bar (both are bottom-centre; at 72px the hint bar painted across the toolbar). */
    bottom: var(--ui-toolbar-bottom);
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

#placement-label {
    background-color: var(--ui-surface);
    border-left-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-top-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    padding-left: var(--ui-space-3);
    padding-right: var(--ui-space-3);
    padding-top: var(--ui-space-1);
    padding-bottom: var(--ui-space-1);
    margin-bottom: var(--ui-space-1);
}

#placement-problem {
    color: var(--ui-danger);
    margin-bottom: var(--ui-space-1);
}

/* Advice, not a refusal: the turret field-of-fire warning reads in the attention colour, not the danger one. */
#placement-problem.placement-advice {
    color: var(--ui-accent);
}

.placement-buttons {
    flex-direction: row;
    align-items: center;
}

/* ---- action bar (W-B R1): the two doors into the game, always on screen ---------------------------------- */

#action-bar {
    left: 0;
    right: 0;
    bottom: var(--ui-space-4);
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* Persistent tool dock: reserved by every gameplay drawer. */
#action-bar { left: 16px; right: 16px; bottom: 12px; flex-direction: column; align-items: stretch; background-color: var(--ui-surface); border-width: 1px; border-color: var(--ui-border); padding: 8px; }
#dock-header { flex-direction: row; align-items: center; margin-bottom: 6px; }
#current-action { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 16px; color: var(--ui-accent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#dock-header .ui-button { margin-top: 0; margin-bottom: 0; min-height: 28px; }
#hud-slots { flex-direction: row; justify-content: center; }
.dock-slot { position: relative; flex-grow: 1; flex-shrink: 1; flex-basis: 0; height: 70px; min-width: 0; margin: 0 3px; padding: 3px; background-color: var(--ui-bg); border-width: 1px; border-color: var(--ui-border); border-radius: 4px; }
.dock-slot:hover { background-color: var(--ui-raised); border-color: var(--ui-text); }
.dock-slot.selected { border-width: 2px; border-color: var(--ui-accent); background-color: var(--ui-raised); }
.dock-slot.unavailable #dock-icon { opacity: 0.45; }
.dock-slot.unavailable #dock-count { color: var(--ui-danger); }
#slot-key { position: absolute; top: 2px; left: 5px; font-size: 13px; color: var(--ui-secondary); }
#dock-icon { width: 32px; height: 32px; align-self: center; margin-top: 4px; }
#dock-count { position: absolute; right: 5px; top: 4px; color: var(--ui-text); font-size: 14px; -unity-font-style: bold; }
#dock-name { font-size: 13px; color: var(--ui-text); -unity-text-align: middle-center; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; margin-top: 4px; }
#engineer-block { bottom: 146px; width: 250px; }
#world-target { right: 16px; bottom: 146px; width: 310px; padding: 12px; }
.target-title { font-size: 18px; -unity-font-style: bold; color: var(--ui-text); white-space: normal; }
.target-action { font-size: 16px; color: var(--ui-accent); white-space: normal; margin-top: 5px; }
.target-detail { font-size: 14px; color: var(--ui-secondary); white-space: normal; margin-top: 6px; }
.target-blocked .target-action { color: var(--ui-danger); }
.target-active .target-action { color: var(--ui-working); }
.target-outline { position: absolute; border-width: 2px; border-color: var(--ui-accent); background-color: rgba(239,191,97,0.08); }
.target-outline.target-blocked { border-color: var(--ui-danger); }
.target-outline.target-active { border-color: var(--ui-working); border-width: 3px; }
#mining { bottom: 310px; width: 250px; }
#placement-toolbar { bottom: 150px; left: 280px; right: 340px; }
#placement-label, #placement-problem { white-space: normal; }
#hand-lock { bottom: 300px; left: 280px; right: 340px; }
#hand-lock-text { white-space: normal; }
.drawer-open #world-target, .drawer-open #target-outline, .drawer-open #goal-card, .drawer-open #problems, .drawer-open #placement-toolbar, .drawer-open #engineer-block { display: none; }
.compact-ui #dock-name { font-size: 11px; }
.compact-ui #dock-header .ui-button { padding-left: 7px; padding-right: 7px; font-size: 13px; }
.compact-ui #current-action { font-size: 13px; }
.compact-ui #engineer-block { width: 210px; }
.compact-ui #world-target { width: 270px; }
.compact-ui #placement-toolbar { left: 235px; right: 290px; }
.compact-ui #status-content { max-width: 94%; }
.compact-ui #core-block { width: 210px; }
#action-bar { left: auto; right: auto; align-self: center; width: 96%; max-width: 1100px; }

#mining { display: none; }
.hud-meter, .hud-meter .unity-progress-bar__container, .hud-meter .unity-progress-bar__background, .hud-meter .unity-progress-bar__progress { height: 6px; min-height: 6px; max-height: 6px; }
.hud-meter { flex-shrink: 0; margin-top: 8px; margin-bottom: 5px; }
.compact-ui #goal-card { width: 300px; padding: 12px; }
.compact-ui #goal-title { font-size: 18px; }
.compact-ui #goal-text { font-size: 14px; }
#goal-why { max-height: 340px; }

.drawer-open #hand-lock { display: none; }
#dock-icon { align-self: flex-start; margin-left: 14px; margin-top: 12px; width: 28px; height: 28px; }
#dock-count { top: 20px; font-size: 13px; }
#dock-name { margin-top: 5px; }

#goal-details-scroll { max-height: 280px; }
.compact-ui #goal-details-scroll { max-height: 100px; }

#weapon { white-space: normal; }
.compact-ui #status-content { max-width: 680px; }
.compact-ui .strip-block { padding-left: 9px; padding-right: 9px; }
.compact-ui .strip-value { font-size: 15px; }
.compact-ui #core-block { width: 220px; }
.compact-ui #engineer-block { left: auto; right: 16px; top: 80px; bottom: auto; width: 245px; }
.compact-ui #engineer-block #weapon, .compact-ui #engineer-block #ammo, .compact-ui #engineer-block #backpack, .compact-ui #engineer-block #reload-meter { display: none; }

/* ---- REL-74 (E-20, U-D-66 (7)): the raid arrow, the wave banner and the report card ----------------------- */

/* The arrow. RaidArrowView sets #raid-arrow's left and top and the head's rotation every frame (the camera moves
   every frame), and paints the head's shape in the head's own colour. Nothing here moves on its own, so reduced
   motion needs no rule. It steps aside while a drawer is open, like the other world-pinned readouts. */
#raid-arrow {
    position: absolute;
    left: 0;
    top: 0;
    width: 36px;
    height: 36px;
}

#raid-arrow-head {
    position: absolute;
    left: 0;
    top: 0;
    width: 36px;
    height: 36px;
    color: var(--ui-danger);
}

#raid-arrow-label {
    position: absolute;
    left: 18px;
    top: 38px;
    translate: -50% 0;
    font-size: var(--ui-font-size-small);
    color: var(--ui-text);
    background-color: rgba(21, 29, 30, 0.88);
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    padding-left: var(--ui-space-2);
    padding-right: var(--ui-space-2);
    padding-top: 1px;
    padding-bottom: 1px;
    margin: 0;
    white-space: nowrap;
}

/* Over a raid it can see, and in the lower half of the screen, the label goes above the head so it never covers
   what the arrow points at or runs under the action bar. */
#raid-arrow.label-above #raid-arrow-label {
    top: auto;
    bottom: 38px;
}

.drawer-open #raid-arrow {
    display: none;
}

/* The banner: one line, top-centre, under the status strip. Up for RaidBannerSource.Seconds. */
#wave-banner {
    position: absolute;
    top: 70px;
    align-self: center;
    max-width: 560px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ui-text);
    background-color: rgba(21, 29, 30, 0.9);
    border-bottom-width: 3px;
    border-bottom-color: var(--ui-danger);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 6px;
    padding-bottom: 6px;
    white-space: normal;
}

.compact-ui #wave-banner {
    top: 64px;
    max-width: 430px;
    font-size: 18px;
}

/* The report card: the relief beat after a raid, top-centre, below where the banner stands. */
#raid-report {
    top: 112px;
    align-self: center;
    width: 420px;
}

.compact-ui #raid-report {
    top: 104px;
    width: 360px;
}

#report-header {
    flex-direction: row;
    align-items: center;
}

#report-title {
    flex-grow: 1;
    flex-shrink: 1;
}

#report-close {
    min-height: 26px;
    height: 26px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 10px;
    padding-right: 10px;
    margin-left: var(--ui-space-2);
    margin-bottom: 8px;
    font-size: 13px;
}

.report-row {
    flex-direction: row;
    justify-content: space-between;
    padding-left: var(--ui-space-1);
    padding-right: var(--ui-space-1);
    padding-top: 1px;
    padding-bottom: 1px;
}

.report-label {
    font-size: 15px;
    color: var(--ui-secondary);
    margin: 0;
    padding: 0;
}

.report-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ui-text);
    margin: 0;
    padding: 0;
}

.report-row.is-bad .report-value {
    color: var(--ui-danger);
}

#report-lesson {
    margin-top: var(--ui-space-2);
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ui-working);
    white-space: normal;
}

#raid-report.report-loss #report-lesson {
    color: var(--ui-danger);
}
