/*
 * Status panel — B-13. Every value here is a token from Styles/tokens.uss; there are no literals except the
 * 1px borders UI Toolkit needs spelled per side. Edit this file, or the panel, in UI Builder: no C# reads it.
 */

.panel {
    position: absolute;
    background-color: var(--ui-surface);
    border-left-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-top-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    color: var(--ui-text);
}

#status-panel {
    top: var(--ui-space-4);
    left: var(--ui-space-4);
    width: 320px;
    padding-left: var(--ui-space-4);
    padding-right: var(--ui-space-4);
    padding-top: var(--ui-space-3);
    padding-bottom: var(--ui-space-3);
}

.panel-title {
    font-size: var(--ui-font-size-title);
    color: var(--ui-accent);
    margin-bottom: var(--ui-space-2);
}

.panel-heading {
    font-size: var(--ui-font-size-heading);
    color: var(--ui-text);
    margin-top: var(--ui-space-2);
    margin-bottom: var(--ui-space-1);
}

.row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--ui-space-1);
}

.row-label {
    font-size: var(--ui-font-size-small);
    color: var(--ui-secondary);
}

.row-value {
    font-size: var(--ui-font-size-body);
    color: var(--ui-text);
    -unity-text-align: middle-right;
}

.hint {
    font-size: var(--ui-font-size-small);
    color: var(--ui-secondary);
    white-space: normal;
    margin-top: var(--ui-space-2);
}

.actions {
    flex-direction: row;
    margin-top: var(--ui-space-3);
}

.actions > Button {
    flex-grow: 1;
    height: 32px;
    font-size: var(--ui-font-size-small);
    color: var(--ui-text);
    background-color: var(--ui-raised);
    border-left-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-top-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-top-left-radius: var(--ui-radius);
    border-top-right-radius: var(--ui-radius);
    border-bottom-left-radius: var(--ui-radius);
    border-bottom-right-radius: var(--ui-radius);
    margin-left: var(--ui-space-1);
    margin-right: var(--ui-space-1);
}

.actions > Button:hover {
    background-color: var(--ui-border);
    color: var(--ui-bg);
}
