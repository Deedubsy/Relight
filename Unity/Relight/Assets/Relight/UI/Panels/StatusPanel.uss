/*
 * Status panel — B-13, tidied in the correction pass (W-B R6).
 *
 * Every value is a token from Styles/tokens.uss. The chrome (.panel, .panel-title, .panel-heading, .ui-button)
 * now lives ONLY in that sheet — this file used to carry its own byte-identical copies, which is exactly the
 * "two places to edit" the one-consistent-style requirement is against. What is left is this panel's own
 * geometry and its rows. Edit this file, or the panel, in UI Builder: no C# reads it.
 */


#status-panel {
    /* Phase C (2026-09-14): a right-side drawer like the Backpack, so it never covers the top-left goal card
       (UI_AND_ONBOARDING.md §4.1 fixes the top-left for the goal card; this Phase B panel is a drawer, not HUD). */
    top: 96px;   /* under the HUD strip, level with the goal card (GoalCard.uss) */
    right: var(--ui-space-4);
    width: 320px;
    padding-left: var(--ui-space-4);
    padding-right: var(--ui-space-4);
    padding-top: var(--ui-space-3);
    padding-bottom: var(--ui-space-3);
}



.row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--ui-space-1);
}

.row-label {
    font-size: var(--ui-font-size-small);
    color: var(--ui-secondary);
}

.row-value {
    font-size: var(--ui-font-size-body);
    color: var(--ui-text);
    -unity-text-align: middle-right;
}

.hint {
    font-size: var(--ui-font-size-small);
    color: var(--ui-secondary);
    white-space: normal;
    margin-top: var(--ui-space-2);
}

.actions {
    flex-direction: row;
    margin-top: var(--ui-space-3);
}

/* Layout only: the button carries `ui-button ui-button-secondary`, so its palette, hover, focus and disabled
   states are the shared ones. */
.actions > Button {
    flex-grow: 1;
}
